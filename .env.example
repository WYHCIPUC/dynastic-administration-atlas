# 管理员登录邮箱（docker-compose 必填，无默认值）
ADMIN_EMAIL=admin@example.com
# 管理员密码的 argon2id 哈希（docker-compose 必填）
# 生成方式：cd web && node -e "require('argon2').hash('你的密码').then(console.log)"
ADMIN_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=4$replace-me"
# 管理员会话签名密钥（docker-compose 必填）：随机长字符串
# 生成方式：openssl rand -base64 48
ADMIN_SESSION_SECRET="generate-a-long-random-secret"
# PostgreSQL 密码（docker-compose 必填，禁止使用弱口令）
POSTGRES_PASSWORD="replace-with-strong-password"
# PostgreSQL 用户名与库名（可选，默认均为 atlas；修改后需与 DATABASE_URL 保持一致）
POSTGRES_USER=atlas
POSTGRES_DB=atlas
