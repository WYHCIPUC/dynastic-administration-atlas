# 应用数据库连接串：本地开发直连宿主机 127.0.0.1；docker-compose 内部使用 db:5432
DATABASE_URL="postgresql://atlas:replace-with-strong-password@127.0.0.1:5432/atlas?schema=public"
# PostgreSQL 账号（供 docker-compose 使用，可选，默认 atlas）
POSTGRES_USER=atlas
# PostgreSQL 密码（docker-compose 必填，禁止使用弱口令）
POSTGRES_PASSWORD="replace-with-strong-password"
# PostgreSQL 库名（可选，默认 atlas）
POSTGRES_DB=atlas
# 管理员登录邮箱（必填）
ADMIN_EMAIL="admin@example.com"
# 管理员密码的 argon2id 哈希（必填）
# 生成方式：node -e "require('argon2').hash('你的密码').then(console.log)"
ADMIN_PASSWORD_HASH="replace-with-argon2id-hash"
# 管理员会话签名密钥（必填）：随机长字符串，严禁使用开发默认值
# 生成方式：openssl rand -base64 48
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
AI_EXPLAINER_ENABLED="false"
EMBEDDING_ENABLED="false"
